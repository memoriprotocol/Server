      "verbatimFragment": "\"hero/skill/6009/1\",'Release\\x20${cfg.args.num}\\x20explosive\\x20scarabs.\\x20Each\\x20scarab\\x20deals\\x20${cfg.args.damage/100}\\x20DMG.\\x20Release\\x20an\\x20extra\\x20scarab\\x20for\\x20every\\x201000\\x20Max\\x20HP\\x20Mummy\\x20has.'"
